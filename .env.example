# Server-side only. Never expose these to the browser. No secrets in this file.
#
# Stage 1 — Nano Banana Pro, Gemini image generation.
# Docs: https://ai.google.dev/gemini-api/docs/image-generation
# Model: gemini-3-pro-image
# SDK: @google/genai — ai.models.generateContent with config.imageConfig
# (aspectRatio, imageSize). The route sends the product photo inline and
# asks for a 9:16 still. It does not run without this key.
GEMINI_API_KEY=

# Optional overrides. Defaults are the values shown.
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
# GEMINI_IMAGE_SIZE=2K

# Stage 2 — Seedance 2.0 image-to-video on fal.ai.
# Docs: https://fal.ai/models/bytedance/seedance-2.0/image-to-video/api
# SDK: @fal-ai/client — fal.queue.submit, then fal.queue.status, then
# fal.queue.result. The client reads FAL_KEY. Input image is required.
# This app locks one format: 9:16, 15 seconds, 720p, audio off.
# Listed price for bytedance/seedance-2.0/image-to-video is $0.3024
# per second (fal.ai Seedance 2.0 API README). A 15s clip is about $4.54.
# The route does not run, and does not invent a video URL, without this key.
FAL_KEY=

# Optional. Default: bytedance/seedance-2.0/image-to-video
# SEEDANCE_MODEL=bytedance/seedance-2.0/image-to-video
